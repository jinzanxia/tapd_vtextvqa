#!/bin/bash
#SBATCH --job-name=qwen3_finetune_8b
#SBATCH --partition=a100
#SBATCH --gpus=1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=80G
#SBATCH --time=72:00:00
#SBATCH -o ./logs/qwen3_finetune_8b_fx.%N.%j.out
#SBATCH -e ./logs/qwen3_finetune_8b_fx.%N.%j.err

set -euo pipefail

IMAGE="docker://xiaojino/sfa:v1.2"
TRAIN_SCRIPT_PATH="$PWD/infer_codes/qwen_finetune.py"
EVAL_SCRIPT_PATH="$PWD/infer_codes/qwen.py"

# Qwen3-VL needs a transformers build that includes Qwen3VLForConditionalGeneration.
# Set to 0 if your container already has a compatible transformers version.
INSTALL_QWEN3_TRANSFORMERS="${INSTALL_QWEN3_TRANSFORMERS:-1}"

DATA_DIR="/mnt/fast/nobackup/scratch4weeks/nc324se/data/M4-ViteVQA"
train_JSON="${DATA_DIR}/Annotations/ViteVQA_0.0.2_t1s1train.json"
GT_JSON="${DATA_DIR}/Annotations/ViteVQA_0.0.2_t1s1val.json"
VIDEO_DIR="${DATA_DIR}/video"
VTS_MODEL="${DATA_DIR}/GoMatching_pp_vitaeb_bovtext.pth"
VTS_CONFIG="./GoMatching/configs/GoMatching_PP_BOVText_vit.yaml"
MODEL_NAME="Qwen/Qwen3-VL-8B-Instruct"
OUTPUT_DIR="./checkpoints/qwen3_vl_8b_lora_4corners_fx"
OUTPUT_JSON="./results/qwen3_vl_8b_lora_val_4corners_fx.json"

mkdir -p ./logs ./results "${OUTPUT_DIR}"

if command -v apptainer >/dev/null 2>&1; then
    CTR="apptainer"
elif command -v singularity >/dev/null 2>&1; then
    CTR="singularity"
else
    echo "Neither apptainer nor singularity found."
    exit 1
fi

for path in "${TRAIN_SCRIPT_PATH}" "${EVAL_SCRIPT_PATH}" "${train_JSON}" "${GT_JSON}" "${VTS_MODEL}" "${VTS_CONFIG}"; do
    test -f "${path}" || { echo "Missing file: ${path}"; exit 1; }
done

test -d "${VIDEO_DIR}" || { echo "Missing video dir: ${VIDEO_DIR}"; exit 1; }

${CTR} exec --nv \
    --bind "${PWD}:${PWD}" \
    --pwd "${PWD}" \
    --env TOKENIZERS_PARALLELISM=false \
    --env PYTHONPATH="${PWD}:${PYTHONPATH:-}" \
    "${IMAGE}" \
    bash -lc "
if [ '${INSTALL_QWEN3_TRANSFORMERS}' = '1' ]; then
    python -m pip install --user --no-cache-dir --upgrade 'transformers>=4.57.0' accelerate qwen-vl-utils
fi

python - <<'PYCODE' || python -m pip install --user --no-cache-dir peft
import peft
print('PEFT OK:', peft.__version__)
PYCODE

echo '===== START TRAINING Qwen3-VL-8B-Instruct ====='
python -m torch.distributed.run \
    --standalone \
    --nproc_per_node=1 \
    ${TRAIN_SCRIPT_PATH} \
    --gt-json ${train_JSON} \
    --video-dir ${VIDEO_DIR} \
    --model-name ${MODEL_NAME} \
    --vts-config ${VTS_CONFIG} \
    --vts-model ${VTS_MODEL} \
    --output-dir ${OUTPUT_DIR} \
    --num-train-epochs 1 \
    --train-batch-size 1 \
    --learning-rate 1e-4 \
    --warmup-steps 100 \
    --gradient-accumulation-steps 2 \
    --max-target-length 64 \
    --use-lora \
    --lora-r 16 \
    --lora-alpha 32 \
    --lora-dropout 0.05 \
    --lora-target-modules q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj \
    --gradient-checkpointing \
    --no-ocr-text \
    --no-focus-bonus \
    --layout-zoom off \
    --crop-mode fixed \
    --density-top-k 0 \
    --density-nms 0.5 \
    --no-object-detect

echo '===== TRAINING FINISHED ====='

echo '===== START EVALUATION WITH Qwen3 ADAPTER ====='
python ${EVAL_SCRIPT_PATH} \
    --gt-json ${GT_JSON} \
    --video-dir ${VIDEO_DIR} \
    --model-name ${MODEL_NAME} \
    --adapter-path ${OUTPUT_DIR}/final \
    --vts-config ${VTS_CONFIG} \
    --vts-model ${VTS_MODEL} \
    --output ${OUTPUT_JSON} \
    --no-ocr-text \
    --no-focus-bonus \
    --layout-zoom off \
    --crop-mode fixed \
    --density-top-k 0 \
    --density-nms 0.5 \
    --no-object-detect

echo '===== Qwen3 FINE-TUNING + EVALUATION FINISHED ====='
echo 'Output dir: ${OUTPUT_DIR}'
echo 'Result file: ${OUTPUT_JSON}'
"
