#!/bin/bash
#SBATCH --job-name=qwen_direct_frames
#SBATCH --partition=a100
#SBATCH --gpus=1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --mem=80G
#SBATCH --time=24:00:00
#SBATCH -o ./logs/qwen_direct_frames.%N.%j.out
#SBATCH -e ./logs/qwen_direct_frames.%N.%j.err

set -euo pipefail

IMAGE="docker://xiaojino/sfa:v1.2"
SCRIPT_PATH="$PWD/infer_codes/qwen_direct_frames.py"

DATA_DIR="/mnt/fast/nobackup/scratch4weeks/nc324se/data/M4-ViteVQA"
GT_JSON="${DATA_DIR}/Annotations/ViteVQA_0.0.2_t1s1val.json"
VIDEO_DIR="${DATA_DIR}/video"

MODEL_NAME="${MODEL_NAME:-Qwen/Qwen2.5-VL-7B-Instruct}"
ADAPTER_PATH="${ADAPTER_PATH:-}"
NUM_SAMPLED_FRAMES="${NUM_SAMPLED_FRAMES:-8}"
OUTPUT_JSON="${OUTPUT_JSON:-./results/qwen_direct_frames_val.json}"

# Set to 1 when MODEL_NAME is Qwen/Qwen3-VL-8B-Instruct and the container
# does not already include Qwen3VLForConditionalGeneration.
INSTALL_QWEN3_TRANSFORMERS="${INSTALL_QWEN3_TRANSFORMERS:-0}"

mkdir -p ./logs ./results

if command -v apptainer >/dev/null 2>&1; then
    CTR="apptainer"
elif command -v singularity >/dev/null 2>&1; then
    CTR="singularity"
else
    echo "Neither apptainer nor singularity found."
    exit 1
fi

for path in "${SCRIPT_PATH}" "${GT_JSON}"; do
    test -f "${path}" || { echo "Missing file: ${path}"; exit 1; }
done

test -d "${VIDEO_DIR}" || { echo "Missing video dir: ${VIDEO_DIR}"; exit 1; }

${CTR} exec --nv \
    --bind "${PWD}:${PWD}" \
    --pwd "${PWD}" \
    --env TOKENIZERS_PARALLELISM=false \
    --env PYTHONPATH="${PWD}:${PYTHONPATH:-}" \
    "${IMAGE}" \
    bash -lc "
if [ '${INSTALL_QWEN3_TRANSFORMERS}' = '1' ]; then
    python -m pip install --user --no-cache-dir --upgrade 'transformers>=4.57.0' accelerate qwen-vl-utils
fi

ADAPTER_ARGS=()
if [ -n '${ADAPTER_PATH:-}' ]; then
    ADAPTER_ARGS=(--adapter-path '${ADAPTER_PATH}')
fi

echo '===== START DIRECT-FRAME QWEN INFERENCE WITHOUT SFA ====='
echo 'Model: ${MODEL_NAME}'
echo 'Sampled frames: ${NUM_SAMPLED_FRAMES}'
echo 'Adapter: ${ADAPTER_PATH:-none}'

python ${SCRIPT_PATH} \
    --gt-json ${GT_JSON} \
    --video-dir ${VIDEO_DIR} \
    --model-name ${MODEL_NAME} \
    \"\${ADAPTER_ARGS[@]}\" \
    --output ${OUTPUT_JSON} \
    --num-sampled-frames ${NUM_SAMPLED_FRAMES}

echo '===== DIRECT-FRAME INFERENCE FINISHED ====='
echo 'Output json: ${OUTPUT_JSON}'
"
